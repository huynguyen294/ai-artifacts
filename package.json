{
  "name": "ai-artifacts",
  "displayName": "AI Artifacts - Interactive Review & Multi-Agent Work Sessions",
  "publisher": "huynguyen294",
  "description": "Interactive artifact review for AI-generated plans, Markdown specs, and proposals with inline feedback. Organize artifacts and shared instructions in Work Sessions across agents and chats. Connects via MCP to Cursor, Codex, Claude, GitHub Copilot, Cline, Windsurf, and more.",
  "version": "1.1.4",
  "type": "module",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/huynguyen294/ai-artifacts"
  },
  "engines": {
    "vscode": ">=1.95.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "artifact",
    "artifacts",
    "ai-artifact",
    "ai-artifacts",
    "mcp",
    "model-context-protocol",
    "markdown",
    "markdown-preview",
    "markdown-editor",
    "inline-review",
    "spec-review",
    "planning",
    "ai-planning",
    "proposal",
    "prd",
    "rfc",
    "design-doc",
    "annotation",
    "cursor",
    "codex",
    "claude",
    "copilot",
    "github-copilot",
    "cline",
    "windsurf",
    "roo-code",
    "agent",
    "workflow"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:agentPlus.artifactReview",
    "onCustomEditor:agentPlus.workSession",
    "onView:agentPlus.recentArtifacts",
    "onView:agentPlus.sessions",
    "onCommand:agentPlus.filterRecentArtifacts",
    "onCommand:agentPlus.createSession",
    "onCommand:agentPlus.openWorkSession",
    "onCommand:agentPlus.manageSessionTypes",
    "onCommand:agentPlus.openArtifactReview",
    "onCommand:agentPlus.searchArtifact",
    "onCommand:agentPlus.installAllIntegrations",
    "onCommand:agentPlus.installCopilotIntegration",
    "onCommand:agentPlus.installCodexIntegration",
    "onCommand:agentPlus.installCursorIntegration",
    "onCommand:agentPlus.installClaudeIntegration",
    "onCommand:agentPlus.installWindsurfIntegration",
    "onCommand:agentPlus.installClineIntegration",
    "onCommand:agentPlus.installAntigravityIntegration",
    "onCommand:agentPlus.copyMcpConfig",
    "onCommand:agentPlus.copyReviewSkill",
    "onCommand:agentPlus.verifyGlobalIntegration",
    "onCommand:agentPlus.uninstallAllIntegrations",
    "onCommand:agentPlus.uninstallCopilotIntegration",
    "onCommand:agentPlus.uninstallCodexIntegration",
    "onCommand:agentPlus.uninstallCursorIntegration",
    "onCommand:agentPlus.uninstallClaudeIntegration",
    "onCommand:agentPlus.uninstallWindsurfIntegration",
    "onCommand:agentPlus.uninstallClineIntegration",
    "onCommand:agentPlus.uninstallAntigravityIntegration"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "agentPlus.openArtifactReview",
        "title": "Open Artifact Review",
        "category": "AI Artifacts"
      },
      {
        "command": "agentPlus.searchArtifact",
        "title": "AI Artifacts: Search Artifact"
      },
      {
        "command": "agentPlus.filterRecentArtifacts",
        "title": "Filter Recent Artifacts",
        "category": "AI Artifacts",
        "icon": "$(filter)"
      },
      {
        "command": "agentPlus.createSession",
        "title": "Add Session",
        "category": "AI Artifacts",
        "icon": "$(plus)"
      },
      {
        "command": "agentPlus.openWorkSession",
        "title": "AI Artifacts: Open Work Session"
      },
      {
        "command": "agentPlus.manageSessionTypes",
        "title": "AI Artifacts: Manage Session Types",
        "icon": "$(gear)"
      },
      {
        "command": "agentPlus.filterSessions",
        "title": "Filter Sessions",
        "category": "AI Artifacts",
        "icon": "$(filter)"
      },
      {
        "command": "agentPlus.searchSessions",
        "title": "Search Sessions",
        "category": "AI Artifacts",
        "icon": "$(search)"
      },
      {
        "command": "agentPlus.pinArtifact",
        "title": "Pin Artifact",
        "category": "AI Artifacts",
        "icon": "$(pin)"
      },
      {
        "command": "agentPlus.unpinArtifact",
        "title": "Unpin Artifact",
        "category": "AI Artifacts",
        "icon": "$(pinned)"
      },
      {
        "command": "agentPlus.archiveArtifact",
        "title": "Archive Artifact",
        "category": "AI Artifacts",
        "icon": "$(archive)"
      },
      {
        "command": "agentPlus.restoreArtifact",
        "title": "Restore Artifact",
        "category": "AI Artifacts"
      },
      {
        "command": "agentPlus.deleteArtifactPermanently",
        "title": "Delete Artifact Permanently",
        "category": "AI Artifacts",
        "icon": "$(trash)"
      },
      {
        "command": "agentPlus.copyArtifactConnectPromptFromTree",
        "title": "Copy Connect Prompt",
        "category": "AI Artifacts",
        "icon": "$(link)"
      },
      {
        "command": "agentPlus.pinSession",
        "title": "Pin Session",
        "category": "AI Artifacts",
        "icon": "$(pin)"
      },
      {
        "command": "agentPlus.unpinSession",
        "title": "Unpin Session",
        "category": "AI Artifacts",
        "icon": "$(pinned)"
      },
      {
        "command": "agentPlus.archiveSession",
        "title": "Archive Session",
        "category": "AI Artifacts",
        "icon": "$(archive)"
      },
      {
        "command": "agentPlus.restoreSession",
        "title": "Restore Session",
        "category": "AI Artifacts"
      },
      {
        "command": "agentPlus.deleteSessionPermanently",
        "title": "Delete Session Permanently",
        "category": "AI Artifacts",
        "icon": "$(trash)"
      },
      {
        "command": "agentPlus.copySessionConnectPromptFromTree",
        "title": "Copy Connect Prompt",
        "category": "AI Artifacts",
        "icon": "$(link)"
      },
      {
        "command": "agentPlus.openSessionInstructionsFileFromTree",
        "title": "Open Instructions File",
        "category": "AI Artifacts",
        "icon": "$(file-code)"
      },
      {
        "command": "agentPlus.copySessionInstructionsFilePathFromTree",
        "title": "Copy Instructions File Path",
        "category": "AI Artifacts",
        "icon": "$(copy)"
      },
      {
        "command": "agentPlus.renameSessionFromTree",
        "title": "Rename Session",
        "category": "AI Artifacts",
        "icon": "$(edit)"
      },
      {
        "command": "agentPlus.changeSessionTypeFromTree",
        "title": "Change Session Type",
        "category": "AI Artifacts",
        "icon": "$(tag)"
      },
      {
        "command": "agentPlus.installAllIntegrations",
        "title": "AI Artifacts: Install All Detected Integrations"
      },
      {
        "command": "agentPlus.installCopilotIntegration",
        "title": "AI Artifacts: Install Integration for GitHub Copilot"
      },
      {
        "command": "agentPlus.installCodexIntegration",
        "title": "AI Artifacts: Install Integration for Codex"
      },
      {
        "command": "agentPlus.installCursorIntegration",
        "title": "AI Artifacts: Install Integration for Cursor"
      },
      {
        "command": "agentPlus.installClaudeIntegration",
        "title": "AI Artifacts: Install Integration for Claude"
      },
      {
        "command": "agentPlus.installWindsurfIntegration",
        "title": "AI Artifacts: Install Integration for Windsurf"
      },
      {
        "command": "agentPlus.installClineIntegration",
        "title": "AI Artifacts: Install Integration for Cline"
      },
      {
        "command": "agentPlus.installAntigravityIntegration",
        "title": "AI Artifacts: Install Integration for Antigravity"
      },
      {
        "command": "agentPlus.copyMcpConfig",
        "title": "AI Artifacts: Copy MCP Configuration JSON"
      },
      {
        "command": "agentPlus.copyReviewSkill",
        "title": "AI Artifacts: Copy create-review-artifact Skill Markdown"
      },
      {
        "command": "agentPlus.verifyGlobalIntegration",
        "title": "AI Artifacts: Verify All Integrations"
      },
      {
        "command": "agentPlus.uninstallAllIntegrations",
        "title": "AI Artifacts: Uninstall All Detected Integrations"
      },
      {
        "command": "agentPlus.uninstallCopilotIntegration",
        "title": "AI Artifacts: Uninstall Integration for GitHub Copilot"
      },
      {
        "command": "agentPlus.uninstallCodexIntegration",
        "title": "AI Artifacts: Uninstall Integration for Codex"
      },
      {
        "command": "agentPlus.uninstallCursorIntegration",
        "title": "AI Artifacts: Uninstall Integration for Cursor"
      },
      {
        "command": "agentPlus.uninstallClaudeIntegration",
        "title": "AI Artifacts: Uninstall Integration for Claude"
      },
      {
        "command": "agentPlus.uninstallWindsurfIntegration",
        "title": "AI Artifacts: Uninstall Integration for Windsurf"
      },
      {
        "command": "agentPlus.uninstallClineIntegration",
        "title": "AI Artifacts: Uninstall Integration for Cline"
      },
      {
        "command": "agentPlus.uninstallAntigravityIntegration",
        "title": "AI Artifacts: Uninstall Integration for Antigravity"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentPlus-artifacts",
          "title": "AI Artifacts",
          "icon": "$(library)"
        }
      ]
    },
    "views": {
      "agentPlus-artifacts": [
        {
          "id": "agentPlus.recentArtifacts",
          "name": "Recent Artifacts",
          "visibility": "visible"
        },
        {
          "id": "agentPlus.sessions",
          "name": "Sessions",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "agentPlus.openArtifactReview",
          "when": "resourceFilename == artifact.md && resourceScheme == file && !explorerResourceIsFolder",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "agentPlus.openArtifactReview",
          "when": "resourceFilename == artifact.md && resourceScheme == file",
          "group": "navigation@0"
        }
      ],
      "editor/title/context": [
        {
          "command": "agentPlus.openArtifactReview",
          "when": "resourceFilename == artifact.md && resourceScheme == file",
          "group": "navigation@0"
        }
      ],
      "view/title": [
        {
          "command": "agentPlus.filterRecentArtifacts",
          "when": "view == agentPlus.recentArtifacts",
          "group": "navigation@0"
        },
        {
          "command": "agentPlus.createSession",
          "when": "view == agentPlus.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agentPlus.filterSessions",
          "when": "view == agentPlus.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentPlus.searchSessions",
          "when": "view == agentPlus.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentPlus.manageSessionTypes",
          "when": "view == agentPlus.sessions",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentPlus.openArtifact",
          "when": "view == agentPlus.recentArtifacts && (viewItem == artifact || viewItem == artifact.pinned)",
          "group": "0_open@1"
        },
        {
          "command": "agentPlus.copyArtifactConnectPromptFromTree",
          "when": "view == agentPlus.recentArtifacts && (viewItem == artifact || viewItem == artifact.pinned)",
          "group": "1_actions@1"
        },
        {
          "command": "agentPlus.pinArtifact",
          "when": "view == agentPlus.recentArtifacts && viewItem == artifact",
          "group": "2_pin@1"
        },
        {
          "command": "agentPlus.unpinArtifact",
          "when": "view == agentPlus.recentArtifacts && viewItem == artifact.pinned",
          "group": "2_pin@1"
        },
        {
          "command": "agentPlus.archiveArtifact",
          "when": "view == agentPlus.recentArtifacts && (viewItem == artifact || viewItem == artifact.pinned)",
          "group": "3_archive@1"
        },
        {
          "command": "agentPlus.deleteArtifactPermanently",
          "when": "view == agentPlus.recentArtifacts && (viewItem == artifact || viewItem == artifact.pinned)",
          "group": "4_delete@1"
        },
        {
          "command": "agentPlus.openWorkSession",
          "when": "view == agentPlus.sessions && (viewItem == session || viewItem == session.pinned)",
          "group": "0_open@1"
        },
        {
          "command": "agentPlus.renameSessionFromTree",
          "when": "view == agentPlus.sessions && (viewItem == session || viewItem == session.pinned)",
          "group": "1_modify@1"
        },
        {
          "command": "agentPlus.changeSessionTypeFromTree",
          "when": "view == agentPlus.sessions && (viewItem == session || viewItem == session.pinned)",
          "group": "1_modify@2"
        },
        {
          "command": "agentPlus.copySessionConnectPromptFromTree",
          "when": "view == agentPlus.sessions && (viewItem == session || viewItem == session.pinned)",
          "group": "2_connect@1"
        },
        {
          "command": "agentPlus.openSessionInstructionsFileFromTree",
          "when": "view == agentPlus.sessions && (viewItem == session || viewItem == session.pinned)",
          "group": "2_connect@2"
        },
        {
          "command": "agentPlus.copySessionInstructionsFilePathFromTree",
          "when": "view == agentPlus.sessions && (viewItem == session || viewItem == session.pinned)",
          "group": "2_connect@3"
        },
        {
          "command": "agentPlus.pinSession",
          "when": "view == agentPlus.sessions && viewItem == session",
          "group": "3_pin@1"
        },
        {
          "command": "agentPlus.unpinSession",
          "when": "view == agentPlus.sessions && viewItem == session.pinned",
          "group": "3_pin@1"
        },
        {
          "command": "agentPlus.archiveSession",
          "when": "view == agentPlus.sessions && (viewItem == session || viewItem == session.pinned)",
          "group": "4_archive@1"
        },
        {
          "command": "agentPlus.deleteSessionPermanently",
          "when": "view == agentPlus.sessions && (viewItem == session || viewItem == session.pinned)",
          "group": "5_delete@1"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "agentPlus.artifactReview",
        "displayName": "Artifact Review",
        "selector": [
          {
            "filenamePattern": "**/.ai-artifacts/artifacts/**/artifact.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "agentPlus.workSession",
        "displayName": "Work Session",
        "selector": [
          {
            "filenamePattern": "**/.ai-artifacts/conversation-registry/*/conversation.json"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "AI Artifacts",
      "properties": {
        "agentPlus.autoOpenArtifactReview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open Artifact Review in the selected target window after an AI agent creates or reconnects a Markdown artifact."
        },
        "agentPlus.artifactRetentionDays": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "scope": "machine",
          "description": "Permanently delete AI Artifacts whose artifact.json updatedAt is older than this many days when the extension activates."
        }
      }
    }
  },
  "scripts": {
    "vscode:uninstall": "node ./dist/uninstall.cjs",
    "build": "npm run build:extension && npm run build:uninstall && npm run build:webview && npm run build:enhancements && npm run build:integration",
    "build:extension": "esbuild src/extension/extension.ts --bundle --minify --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "build:uninstall": "esbuild src/extension/uninstall-entry.ts --bundle --minify --platform=node --format=cjs --outfile=dist/uninstall.cjs",
    "build:webview": "vite build",
    "dev:webview": "vite --config vite.config.dev.ts",
    "build:enhancements": "esbuild src/webview/enhancements/shiki-entry.ts --bundle --minify --platform=browser --format=iife --outfile=dist/webview/shiki.js && esbuild src/webview/enhancements/mermaid-entry.ts --bundle --minify --platform=browser --format=iife --outfile=dist/webview/mermaid.js",
    "build:integration": "esbuild src/integration/artifact-review-mcp.ts --bundle --minify --platform=node --format=esm --outfile=dist/integration/codex-artifacts-review-mcp.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build:integration && vitest run",
    "clean:releases": "node -e \"const fs = require('fs'); fs.rmSync('releases', { recursive: true, force: true }); fs.mkdirSync('releases', { recursive: true });\"",
    "package": "npm run build && npm run clean:releases && vsce package --allow-missing-repository --out releases/",
    "pack": "npm run package",
    "publish:vscode": "vsce publish",
    "publish:ovsx": "npx ovsx publish"
  },
  "devDependencies": {
    "@floating-ui/react": "^0.27.20",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/vscode": "^1.95.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "yazl": "^2.5.1"
  }
}
